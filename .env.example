# Copie para .env e preencha localmente. Não versione valores reais.
# URLs PostgreSQL: sslmode=require&sslaccept=strict&sslcert=../certs/supabase-ca.crt
# sslcert é relativo à pasta prisma, conforme o conector PostgreSQL do Prisma.
# DATABASE_URL: pooler de transações, porta 6543, pgbouncer=true&connection_limit=1.
# DIRECT_URL: pooler de sessão IPv4, porta 5432, sem pgbouncer=true.
# Em redes IPv6, a conexão direta do projeto também pode ser usada na porta 5432.
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SENTRY_DSN=
